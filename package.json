{
  "name": "memochat-tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A pure TypeScript terminal UI for MemoChat-style AI chat with memory.",
  "scripts": {
    "start": "node --experimental-strip-types src/index.ts",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "doctor": "node --experimental-strip-types src/index.ts --doctor"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
